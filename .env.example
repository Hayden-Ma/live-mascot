# 复制为 .env 后填写；启动后端时加 --env-file .env
# 注意：.env 已被 .gitignore 忽略，不要把填好密钥的 .env 提交到仓库
MINIMAX_API_KEY=
# 部分账号需要 GroupId，不需要可留空
MINIMAX_GROUP_ID=
# 火山方舟（ARK）等其他 LLM 服务商密钥（用到时填）
ARK_API_KEY=
# 网易云音乐登录 Cookie（浏览器登录 music.163.com 后从开发者工具复制），
# 用于解析 VIP/高音质歌曲地址；留空则只能播放非会员歌曲
NETEASE_COOKIE=

# GPU 服务器 SSH（scripts/remote*.cjs、ssh_tunnel*.cjs、ssh_tunnel_keepalive.ps1 使用）
# Node 脚本用密码登录；PowerShell keepalive 用 ~/.ssh/id_ed25519_tunnel 密钥
REMOTE_HOST=
REMOTE_PORT=22
REMOTE_USER=
REMOTE_PASSWORD=
